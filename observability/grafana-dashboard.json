{
  "title": "Atlas Support AI",
  "schemaVersion": 39,
  "panels": [
    {"type":"timeseries","title":"Request latency p95 (seconds)","targets":[{"expr":"histogram_quantile(0.95, sum(rate(atlas_request_duration_seconds_bucket[5m])) by (le, route))"}]},
    {"type":"timeseries","title":"Request throughput","targets":[{"expr":"sum(rate(atlas_requests_total[5m])) by (route)"}]},
    {"type":"timeseries","title":"Errors per second","targets":[{"expr":"sum(rate(atlas_requests_total{status=~\"5..\"}[5m])) by (route)"}]},
    {"type":"timeseries","title":"Estimated input tokens","targets":[{"expr":"sum(rate(atlas_estimated_input_tokens_total[5m])) by (route)"}]}
  ]
}
